+  return `${mode}:${executor}`;
+}
+
+function parseAmpSelection(value: string): { mode: AmpModelId; executor: AmpExecutor } | null {
+  if (isAmpModelId(value)) return { mode: value, executor: 'local' };
+  const [mode, executor, extra] = value.split(':');
+  if (extra !== undefined || !mode || !executor) return null;
+  if (!isAmpModelId(mode) || !AMP_EXECUTORS.includes(executor as AmpExecutor)) return null;
+  return { mode, executor: executor as AmpExecutor };
+}
