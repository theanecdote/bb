diff --git a/src/session-load.test.ts b/src/session-load.test.ts
new file mode 100644
index 0000000..c63de89
--- /dev/null
+++ b/src/session-load.test.ts
@@ -0,0 +1,181 @@
+import { afterEach, beforeEach, describe, expect, it } from 'bun:test';
+import { mkdtemp, mkdir, readFile, rm, stat, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import type { AgentSideConnection } from '@agentclientprotocol/sdk';
+import { AmpAcpAgent } from './server.js';
+import type { AmpExecutionRequest, AmpTransport } from './amp-transport.js';
+
+const AMP_THREAD_ID = 'T-01234567-89ab-cdef-0123-456789abcdef';
+const PROMPT_TEXT = 'PROMPT_TEXT_MUST_NOT_BE_PERSISTED';
+const ASSISTANT_TEXT = 'ASSISTANT_TEXT_MUST_NOT_BE_PERSISTED';
+
+const mockClient = {
+  sessionUpdate: async () => {},
+  readTextFile: async () => ({ text: '' }),
+  writeTextFile: async () => ({}),
+  requestPermission: async () => ({ optionId: '' }),
+  createTerminal: async () => ({ id: '' }),
+  extMethod: async () => ({}),
+  extNotification: async () => {},
+} as unknown as AgentSideConnection;
+
+function recordingTransport(calls: AmpExecutionRequest[]): AmpTransport {
+  return {
+    name: 'cli',
+    async *execute(request) {
+      calls.push(request);
+      yield { type: 'system', subtype: 'init', session_id: AMP_THREAD_ID };
+      yield { type: 'assistant', message: { content: ASSISTANT_TEXT } };
+      yield { type: 'result', subtype: 'success', is_error: false };
+    },
+  };
+}
+
+describe('durable ACP session loading', () => {
+  let stateHome: string;
+  let originalStateHome: string | undefined;
+
+  beforeEach(async () => {
+    originalStateHome = process.env.XDG_STATE_HOME;
+    stateHome = await mkdtemp(path.join(tmpdir(), 'amp-acp-state-'));
+    process.env.XDG_STATE_HOME = stateHome;
+  });
+
+  afterEach(async () => {
+    if (originalStateHome === undefined) {
+      delete process.env.XDG_STATE_HOME;
+    } else {
+      process.env.XDG_STATE_HOME = originalStateHome;
+    }
+    await rm(stateHome, { recursive: true, force: true });
+  });
+
+  it('advertises load support and persists only a protected minimal session mapping', async () => {
+    const calls: AmpExecutionRequest[] = [];
+    const agent = new AmpAcpAgent(mockClient, recordingTransport(calls));
+    const initialized = await agent.initialize({ protocolVersion: 1, clientCapabilities: {} });
+    expect(initialized.agentCapabilities?.loadSession).toBe(true);
+
+    const session = await agent.newSession({ cwd: '/tmp/original-cwd', mcpServers: [] });
+    await agent.prompt({
+      sessionId: session.sessionId,
+      prompt: [{ type: 'text', text: PROMPT_TEXT }],
+    });
+
+    const sessionsDir = path.join(stateHome, 'amp-acp', 'sessions');
+    const mappingPath = path.join(sessionsDir, `${session.sessionId}.json`);
+    expect(JSON.parse(await readFile(mappingPath, 'utf8'))).toEqual({
+      version: 1,
+      sessionId: session.sessionId,
+      threadId: AMP_THREAD_ID,
+    });
+    expect((await stat(sessionsDir)).mode & 0o777).toBe(0o700);
+    expect((await stat(mappingPath)).mode & 0o777).toBe(0o600);
+    const serialized = await readFile(mappingPath, 'utf8');
+    expect(serialized).not.toContain(PROMPT_TEXT);
+    expect(serialized).not.toContain(ASSISTANT_TEXT);
+    expect(calls).toHaveLength(1);
+  });
+
+  it('loads a persisted session into a new agent and continues its exact Amp thread', async () => {
+    const initialCalls: AmpExecutionRequest[] = [];
+    const initial = new AmpAcpAgent(mockClient, recordingTransport(initialCalls));
+    const session = await initial.newSession({ cwd: '/tmp/original-cwd', mcpServers: [] });
+    await initial.prompt({ sessionId: session.sessionId, prompt: [{ type: 'text', text: 'first' }] });
+
+    const resumedCalls: AmpExecutionRequest[] = [];
+    const resumed = new AmpAcpAgent(mockClient, recordingTransport(resumedCalls));
+    const loaded = await resumed.loadSession({
+      sessionId: session.sessionId,
+      cwd: '/tmp/current-cwd',
+      mcpServers: [],
+    });
+    expect(loaded.configOptions).toHaveLength(2);
+
+    await resumed.prompt({ sessionId: session.sessionId, prompt: [{ type: 'text', text: 'second' }] });
+    expect(resumedCalls).toHaveLength(1);
+    expect(resumedCalls[0]!.options.cwd).toBe('/tmp/current-cwd');
+    expect(resumedCalls[0]!.options.continue).toBe(AMP_THREAD_ID);
+  });
+
+  it('uses only the current load request MCP configuration when resuming', async () => {
+    const initial = new AmpAcpAgent(mockClient, recordingTransport([]));
+    const session = await initial.newSession({
+      cwd: '/tmp/original-cwd',
+      mcpServers: [
+        {
+          type: 'http',
+          name: 'original',
+          url: 'https://original.example/mcp',
+          headers: [{ name: 'Authorization', value: 'Bearer original' }],
+        },
+      ],
+    });
+    await initial.prompt({ sessionId: session.sessionId, prompt: [{ type: 'text', text: 'first' }] });
+
+    const resumedCalls: AmpExecutionRequest[] = [];
+    const resumed = new AmpAcpAgent(mockClient, recordingTransport(resumedCalls));
+    await resumed.loadSession({
+      sessionId: session.sessionId,
+      cwd: '/tmp/current-cwd',
+      mcpServers: [
+        {
+          name: 'current',
+          command: 'node',
+          args: ['current-mcp.js'],
+          env: [{ name: 'CURRENT_ONLY', value: 'yes' }],
+        },
+      ],
+    });
+
+    await resumed.prompt({ sessionId: session.sessionId, prompt: [{ type: 'text', text: 'second' }] });
+    expect(resumedCalls).toHaveLength(1);
+    expect(resumedCalls[0]!.options.mcpConfig).toEqual({
+      current: {
+        command: 'node',
+        args: ['current-mcp.js'],
+        env: { CURRENT_ONLY: 'yes' },
+      },
+    });
+  });
+
+  it('rejects unknown and path-unsafe ACP session IDs', async () => {
+    const agent = new AmpAcpAgent(mockClient, recordingTransport([]));
+    await expect(agent.loadSession({
+      sessionId: 'S-unknown-session',
+      cwd: '/tmp/current-cwd',
+      mcpServers: [],
+    })).rejects.toThrow('Session not found');
+    await expect(agent.loadSession({
+      sessionId: 'S-../../unsafe',
+      cwd: '/tmp/current-cwd',
+      mcpServers: [],
+    })).rejects.toThrow('Invalid session ID');
+  });
+
+  it('rejects malformed and mismatched persisted records', async () => {
+    const sessionsDir = path.join(stateHome, 'amp-acp', 'sessions');
+    await mkdir(sessionsDir, { recursive: true, mode: 0o700 });
+    const malformedId = 'S-malformed-session';
+    const mismatchedId = 'S-mismatched-session';
+    await writeFile(path.join(sessionsDir, `${malformedId}.json`), '{"version":2}', { mode: 0o600 });
+    await writeFile(path.join(sessionsDir, `${mismatchedId}.json`), JSON.stringify({
+      version: 1,
+      sessionId: 'S-other-session',
+      threadId: AMP_THREAD_ID,
+    }), { mode: 0o600 });
+
+    const agent = new AmpAcpAgent(mockClient, recordingTransport([]));
+    await expect(agent.loadSession({
+      sessionId: malformedId,
+      cwd: '/tmp/current-cwd',
+      mcpServers: [],
+    })).rejects.toThrow('Invalid persisted session');
+    await expect(agent.loadSession({
+      sessionId: mismatchedId,
+      cwd: '/tmp/current-cwd',
+      mcpServers: [],
+    })).rejects.toThrow('Invalid persisted session');
+  });
+});
diff --git a/src/session-store.ts b/src/session-store.ts
new file mode 100644
index 0000000..2ba0a7d
--- /dev/null
+++ b/src/session-store.ts
@@ -0,0 +1,104 @@
+import { chmod, mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import { homedir } from 'node:os';
+import path from 'node:path';
+
+export type PersistedSession = {
+  version: 1;
+  sessionId: string;
+  threadId: string;
+};
+
+const ACP_SESSION_ID = /^S-[A-Za-z0-9][A-Za-z0-9-]*$/;
+const AMP_THREAD_ID = /^T-[A-Za-z0-9][A-Za-z0-9-]*$/;
+
+function stateHome(): string {
+  return process.env.XDG_STATE_HOME || path.join(homedir(), '.local', 'state');
+}
+
+function sessionsDirectory(): string {
+  return path.join(stateHome(), 'amp-acp', 'sessions');
+}
+
+function assertSessionId(sessionId: unknown): asserts sessionId is string {
+  if (typeof sessionId !== 'string' || !ACP_SESSION_ID.test(sessionId)) {
+    throw new Error('Invalid session ID');
+  }
+}
+
+function assertThreadId(threadId: unknown): asserts threadId is string {
+  if (typeof threadId !== 'string' || !AMP_THREAD_ID.test(threadId)) {
+    throw new Error('Invalid Amp thread ID');
+  }
+}
+
+function sessionPath(sessionId: string): string {
+  assertSessionId(sessionId);
+  return path.join(sessionsDirectory(), `${sessionId}.json`);
+}
+
+function parsePersistedSession(value: unknown, requestedSessionId: string): PersistedSession {
+  if (
+    !value ||
+    typeof value !== 'object' ||
+    Array.isArray(value) ||
+    (value as Record<string, unknown>).version !== 1 ||
+    (value as Record<string, unknown>).sessionId !== requestedSessionId ||
+    Object.keys(value as Record<string, unknown>).length !== 3
+  ) {
+    throw new Error('Invalid persisted session');
+  }
+
+  const record = value as PersistedSession;
+  try {
+    assertSessionId(record.sessionId);
+    assertThreadId(record.threadId);
+  } catch {
+    throw new Error('Invalid persisted session');
+  }
+  return record;
+}
+
+async function ensureSessionsDirectory(): Promise<string> {
+  const directory = sessionsDirectory();
+  await mkdir(directory, { recursive: true, mode: 0o700 });
+  await chmod(directory, 0o700);
+  return directory;
+}
+
+export async function persistSession(sessionId: string, threadId: string): Promise<void> {
+  assertSessionId(sessionId);
+  assertThreadId(threadId);
+
+  const directory = await ensureSessionsDirectory();
+  const destination = sessionPath(sessionId);
+  const temporary = path.join(directory, `.${sessionId}.${process.pid}.${Date.now()}.tmp`);
+  const record: PersistedSession = { version: 1, sessionId, threadId };
+
+  await writeFile(temporary, JSON.stringify(record), { encoding: 'utf8', mode: 0o600, flag: 'wx' });
+  await chmod(temporary, 0o600);
+  await rename(temporary, destination);
+  await chmod(destination, 0o600);
+}
+
+export async function loadPersistedSession(sessionId: string): Promise<PersistedSession> {
+  assertSessionId(sessionId);
+
+  let contents: string;
+  try {
+    contents = await readFile(sessionPath(sessionId), 'utf8');
+  } catch (error) {
+    if (error && typeof error === 'object' && 'code' in error && error.code === 'ENOENT') {
+      throw new Error('Session not found');
+    }
+    throw error;
+  }
+
+  try {
+    return parsePersistedSession(JSON.parse(contents) as unknown, sessionId);
+  } catch (error) {
+    if (error instanceof Error && error.message === 'Invalid persisted session') {
+      throw error;
+    }
+    throw new Error('Invalid persisted session');
+  }
+}
